#!/usr/bin/env python3
"""Run the source checkout without installation or generated bytecode."""

import sys


def start() -> int:
    if sys.version_info < (3, 11):
        print("ERROR: ZyFeed requires Python 3.11 or newer.", file=sys.stderr)
        return 1
    sys.dont_write_bytecode = True
    from zyfeed.cli import main

    return main()


if __name__ == "__main__":
    raise SystemExit(start())
